# Committed production-build defaults. NO secrets or project values here.
# Defining the emulator flag as false lets webpack prove the emulator/test-hook
# branch in src/firebase.ts is dead and drop it from production bundles
# (checked by .github/scripts/bundle-canary-scan.sh). The e2e build overrides
# it from the shell (e2e/scripts/build-app.sh).
REACT_APP_USE_FIREBASE_EMULATORS=false
REACT_APP_ENABLE_LEGACY_IMPORT=false
# Film review is a synthetic-data preview (F1). Defined false so webpack drops the Film chunk,
# its sample paths and its navigation entry from production bundles. Preview builds override it
# from the shell (tests/film-f1/build-preview.sh).
REACT_APP_FILM_PREVIEW=false
