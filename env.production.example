# Coach Core AI — CLIENT-SIDE SAMPLE ONLY (Vite + React)
# Copy into .env.local for local TEST use. DO NOT commit .env.local.
# This app intentionally sets envPrefix: 'REACT_APP_' in vite.config.ts.
# These values may be visible in the built browser JS. NO SECRETS HERE.

# Firebase Web SDK configuration for an authorized NON-PRODUCTION test project
REACT_APP_FIREBASE_API_KEY=your_firebase_web_api_key
REACT_APP_FIREBASE_AUTH_DOMAIN=your-test-project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-test-project
REACT_APP_FIREBASE_STORAGE_BUCKET=your-test-project.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_web_messaging_sender_id
REACT_APP_FIREBASE_APP_ID=your_firebase_web_app_id
REACT_APP_FIREBASE_MEASUREMENT_ID=

# Default: no remote model calls. Proxy must authenticate the signed-in coach.
REACT_APP_AI_ENABLED=false
REACT_APP_AI_PROXY_ENDPOINT=/api/ai

# Restrict feature-gated screens; content review should never be broadly visible in production.
REACT_APP_ENABLE_PLAYBOOK_V2=false
REACT_APP_ENABLE_CONTENT_REVIEW=false

# Optional public monitoring config. Sentry auth token belongs only in CI secrets.
REACT_APP_SENTRY_DSN=
REACT_APP_DEPLOY_ENV=development
REACT_APP_RELEASE=

# NEVER set OPENAI_API_KEY, GEMINI_API_KEY, service-account JSON,
# Firebase Admin credentials or SENTRY_AUTH_TOKEN in a frontend .env file.
# Actual production configuration is supplied by a reviewed deployment pipeline.
