rules_version = '2';

// Coach Core AI — Firestore security rules (private beta)
//
// Model: owner-only tenancy. A team has exactly one owner (the coach). Plays
// and practice plans belong to exactly one team and are visible only to that
// team's owner. Team membership/invites are disabled for the private beta.
//
// Every client access requires a private-beta identity:
//   * signed in with a real provider (never anonymous),
//   * verified email,
//   * custom claim `beta == true` (granted server-side by an admin script).
//
// Anything not matched below is denied. Server-only collections
// (userProfiles, notifications, analytics, aiUsage, betaUsers, ...) have no
// client rules on purpose; Cloud Functions use the Admin SDK.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- identity ----------
    function signedIn() {
      return request.auth != null;
    }

    function isBetaUser() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.auth.token.email_verified == true
        && request.auth.token.beta == true;
    }

    // ---------- tenancy ----------
    function teamPath(teamId) {
      return /databases/$(database)/documents/teams/$(teamId);
    }

    function ownsTeam(teamId) {
      return teamId is string
        && exists(teamPath(teamId))
        && get(teamPath(teamId)).data.ownerId == request.auth.uid;
    }

    // ---------- validation helpers ----------
    function isShortString(v, minLen, maxLen) {
      return v is string && v.size() >= minLen && v.size() <= maxLen;
    }

    function isBoundedList(v, maxLen) {
      return v is list && v.size() <= maxLen;
    }

    function unchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    // Optimistic concurrency (persistence contract v1). New documents may
    // start at revision 1. Once a document carries a revision, every update
    // must send exactly resource.revision + 1, so a stale editor is denied
    // instead of silently overwriting (client shows a conflict).
    function revisionOnCreate(d) {
      return !('revision' in d) || d.revision == 1;
    }
    function revisionOnUpdate() {
      return ('revision' in resource.data)
        ? (('revision' in request.resource.data)
            && request.resource.data.revision == resource.data.revision + 1)
        : (!('revision' in request.resource.data) || request.resource.data.revision == 1);
    }

    // ---------- teams ----------
    function validNewTeam() {
      let d = request.resource.data;
      return d.keys().hasAll(['name', 'ownerId', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['name', 'code', 'ownerId', 'memberIds', 'memberDetails',
                             'createdAt', 'updatedAt'])
        && isShortString(d.name, 1, 80)
        && d.ownerId == request.auth.uid
        && (!('code' in d) || isShortString(d.code, 4, 16))
        && (!('memberIds' in d) || d.memberIds == [request.auth.uid])
        && (!('memberDetails' in d) || isBoundedList(d.memberDetails, 1))
        && d.createdAt is timestamp
        && d.updatedAt is timestamp;
    }

    function validTeamUpdate() {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys().hasOnly(['name', 'updatedAt'])
        && isShortString(d.name, 1, 80)
        && d.updatedAt is timestamp;
    }

    match /teams/{teamId} {
      // `list` requires the query to filter on ownerId == request.auth.uid.
      allow get, list: if isBetaUser() && resource.data.ownerId == request.auth.uid;
      allow create: if isBetaUser() && validNewTeam();
      allow update: if isBetaUser()
        && resource.data.ownerId == request.auth.uid
        && validTeamUpdate();
      // No client-side team deletion during the beta: a deleted team id could
      // be re-created by another coach and inherit the orphaned plays, plans
      // and files (review finding M5). Deletion will move to a server
      // function that removes child data first.
      allow delete: if false;
    }

    // ---------- plays ----------
    function validPlayFields(d) {
      return d.keys().hasAll(['name', 'teamId', 'createdBy', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['name', 'formation', 'description', 'routes', 'players',
                             'tags', 'difficulty', 'sport', 'phase', 'type',
                             'localId', 'revision', 'teamId', 'createdBy',
                             'createdAt', 'updatedAt'])
        && (!('phase' in d) || d.phase in ['offense', 'defense', 'special_teams'])
        && (!('type' in d) || isShortString(d.type, 0, 40))
        && (!('localId' in d) || isShortString(d.localId, 1, 64))
        && (!('revision' in d) || (d.revision is int && d.revision >= 1))
        && isShortString(d.name, 1, 120)
        && (!('formation' in d) || isShortString(d.formation, 0, 80))
        && (!('description' in d) || isShortString(d.description, 0, 2000))
        && (!('routes' in d) || isBoundedList(d.routes, 60))
        && (!('players' in d) || isBoundedList(d.players, 30))
        && (!('tags' in d) || isBoundedList(d.tags, 20))
        && (!('difficulty' in d) || d.difficulty in ['beginner', 'intermediate', 'advanced'])
        && (!('sport' in d) || isShortString(d.sport, 0, 40))
        && d.createdAt is timestamp
        && d.updatedAt is timestamp;
    }

    match /plays/{playId} {
      // `list` requires the query to filter on teamId == <a team the caller owns>.
      // A missing id is readable (result: not found) so create-only transactions
      // can check before writing (D10 import). Existing documents keep owner-only
      // reads; `list` is unchanged. Side effect: a beta user can tell whether an
      // id exists (not-found vs permission-denied). Accepted: copy ids are
      // SHA-256 of uid+team+content and other ids are random.
      allow get: if isBetaUser() && (resource == null || ownsTeam(resource.data.teamId));
      allow list: if isBetaUser() && ownsTeam(resource.data.teamId);
      allow create: if isBetaUser()
        && validPlayFields(request.resource.data)
        && revisionOnCreate(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && ownsTeam(request.resource.data.teamId);
      allow update: if isBetaUser()
        && ownsTeam(resource.data.teamId)
        && revisionOnUpdate()
        && unchanged('teamId')
        && unchanged('createdBy')
        && unchanged('createdAt')
        && validPlayFields(request.resource.data);
      allow delete: if isBetaUser() && ownsTeam(resource.data.teamId);
    }

    // ---------- practice plans ----------
    function validPlanFields(d) {
      return d.keys().hasAll(['name', 'teamId', 'createdBy', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['name', 'date', 'duration', 'periods', 'goals', 'notes',
                             'source', 'safetyConsiderations', 'aiRequestId', 'revision',
                             'ageGroup', 'skillLevel', 'contactLevel', 'hydrationBreakMinutes',
                             'teamId', 'createdBy', 'createdAt', 'updatedAt'])
        && (!('ageGroup' in d) || d.ageGroup in ['6U', '8U', '10U', '12U', '14U',
                                                   'HS_JV', 'HS_VARSITY', 'ADULT'])
        && (!('skillLevel' in d) || d.skillLevel in ['beginner', 'intermediate', 'advanced'])
        && (!('contactLevel' in d) || d.contactLevel in ['non_contact', 'limited_contact', 'full_contact'])
        && (!('hydrationBreakMinutes' in d) || isBoundedList(d.hydrationBreakMinutes, 20))
        && (!('safetyConsiderations' in d) || isBoundedList(d.safetyConsiderations, 20))
        && (!('aiRequestId' in d) || isShortString(d.aiRequestId, 1, 64))
        && (!('revision' in d) || (d.revision is int && d.revision >= 1))
        // 200 = coach-ai.v1 practice_plan title bound, so AI titles save losslessly.
        && isShortString(d.name, 1, 200)
        && (!('date' in d) || isShortString(d.date, 0, 40))
        && (!('duration' in d) || (d.duration is number && d.duration >= 0 && d.duration <= 600))
        && (!('periods' in d) || isBoundedList(d.periods, 40))
        && (!('goals' in d) || isBoundedList(d.goals, 20))
        && (!('notes' in d) || isShortString(d.notes, 0, 5000))
        && (!('source' in d) || d.source in ['manual', 'ai'])
        && d.createdAt is timestamp
        && d.updatedAt is timestamp;
    }

    match /practicePlans/{planId} {
      // A missing id is readable (result: not found) so create-only transactions
      // can check before writing (D10 import). Existing documents keep owner-only
      // reads; `list` is unchanged. Side effect: a beta user can tell whether an
      // id exists (not-found vs permission-denied). Accepted: copy ids are
      // SHA-256 of uid+team+content and other ids are random.
      allow get: if isBetaUser() && (resource == null || ownsTeam(resource.data.teamId));
      allow list: if isBetaUser() && ownsTeam(resource.data.teamId);
      allow create: if isBetaUser()
        && validPlanFields(request.resource.data)
        && revisionOnCreate(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && ownsTeam(request.resource.data.teamId);
      allow update: if isBetaUser()
        && ownsTeam(resource.data.teamId)
        && revisionOnUpdate()
        && unchanged('teamId')
        && unchanged('createdBy')
        && unchanged('createdAt')
        && validPlanFields(request.resource.data);
      allow delete: if isBetaUser() && ownsTeam(resource.data.teamId);
    }

    // Everything else: no client access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
