rules_version='2'

// Tested against the emulator in rules-tests/firestore.rules.test.ts (npm run test:rules; CI job firestore-rules).
// Deploying these rules to a live project is the owner's call: firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is the team owner (coach)
    function isTeamOwner(teamId) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/teams/$(teamId)).data.ownerId == request.auth.uid;
    }

    // Admins (waitlist and user-profile access). The email must be verified: anyone can create an
    // email/password account with an unverified address, so an unverified email proves nothing.
    function isAdmin() {
      return isAuthenticated() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email in [
          'admin@coachcore.ai',
          'jones@coachcore.ai',
          'support@coachcore.ai',
          'digitalblueprint239@gmail.com'
        ];
    }

    // Teams collection
    match /teams/{teamId} {
      // The owner and listed members can read the team. Checked on the team document itself (not with get())
      // so the app's "my teams" query (memberIds array-contains uid) can be proven by the rules.
      // Denied: "Only the coach can access this team."
      allow read: if isAuthenticated() &&
        (resource.data.ownerId == request.auth.uid || request.auth.uid in resource.data.memberIds);

      // Coaches can create teams; they become the owner and the only member
      // Denied: "Only authenticated coaches can create teams."
      allow create: if isAuthenticated() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.memberIds == [request.auth.uid];

      // Only team owners can update team data, and ownership cannot be handed over by an update
      // Denied: "Only the coach can modify this team."
      allow update: if isTeamOwner(teamId) &&
        request.resource.data.ownerId == resource.data.ownerId &&
        // An owner must stay a member. Otherwise the app's memberIds query
        // would hide the team even from its owner after a malformed update.
        request.resource.data.memberIds is list &&
        request.auth.uid in request.resource.data.memberIds;

      // Only team owners can delete teams
      // Denied: "Only the coach can delete this team."
      allow delete: if isTeamOwner(teamId);
    }

    // Practice Plans collection
    match /practicePlans/{planId} {
      // Only the coach can read practice plans
      // Denied: "Only the coach can view practice plans."
      allow read: if isTeamOwner(resource.data.teamId);

      // Only the coach can create practice plans
      // Denied: "Only the coach can create practice plans."
      allow create: if isAuthenticated() &&
        isTeamOwner(request.resource.data.teamId) &&
        request.resource.data.createdBy == request.auth.uid;

      // Only the coach can update practice plans; a doc cannot be moved to another team or re-attributed
      // Denied: "Only the coach can modify practice plans."
      allow update: if isTeamOwner(resource.data.teamId) &&
        request.resource.data.teamId == resource.data.teamId &&
        request.resource.data.createdBy == resource.data.createdBy;

      // Only the coach can delete practice plans
      // Denied: "Only the coach can delete practice plans."
      allow delete: if isTeamOwner(resource.data.teamId);
    }

    // Plays collection
    match /plays/{playId} {
      // Only the coach can read plays
      // Denied: "Only the coach can view plays."
      allow read: if isTeamOwner(resource.data.teamId);

      // Only the coach can create plays
      // Denied: "Only the coach can create plays."
      allow create: if isAuthenticated() &&
        isTeamOwner(request.resource.data.teamId) &&
        request.resource.data.createdBy == request.auth.uid &&
        // Canonical v3 plays start at revision 1 (optimistic concurrency, T-109).
        (request.resource.data.get('schemaVersion', 0) != 3 || request.resource.data.get('revision', 0) == 1) &&
        // Canonical v4 plays start at revision 1, are well formed, and are written together with revision copy 1.
        (request.resource.data.get('schemaVersion', 0) != 4 ||
          (request.resource.data.revision == 1 && isWellFormedPlayV4(request.resource.data) &&
            hasRevisionCopy(playId, request.resource.data)));

      // Only the coach can update plays; a doc cannot be moved to another team or re-attributed
      // Denied: "Only the coach can modify plays."
      allow update: if isTeamOwner(resource.data.teamId) &&
        request.resource.data.teamId == resource.data.teamId &&
        request.resource.data.createdBy == resource.data.createdBy &&
        // A legacy v1/v2 play must never be silently rewritten as v3 in place.
        // The editor creates a NEW document with provenance instead.
        request.resource.data.get('schemaVersion', 0) == resource.data.get('schemaVersion', 0) &&
        // v3 drafts must move exactly one revision forward. Older plays keep
        // their existing update semantics without acquiring v3-only rules.
        (resource.data.get('schemaVersion', 0) != 3 ||
          request.resource.data.get('revision', 0) == resource.data.get('revision', 0) + 1) &&
        // v4 plays move exactly one revision forward, stay well formed, keep their provenance, and every saved
        // revision is written together with its immutable copy.
        (resource.data.get('schemaVersion', 0) != 4 ||
          (request.resource.data.revision == resource.data.revision + 1 &&
            request.resource.data.provenance == resource.data.provenance &&
            isWellFormedPlayV4(request.resource.data) &&
            hasRevisionCopy(playId, request.resource.data)));

      // Only the coach can delete plays
      // Denied: "Only the coach can delete plays."
      allow delete: if isTeamOwner(resource.data.teamId);

      // Revision history of a v4 play: one immutable copy per saved revision, coach only.
      match /revisions/{revisionId} {
        allow read: if isTeamOwner(resource.data.teamId);

        // A copy can only be written in the same commit as the play revision it copies, and must match it.
        allow create: if isTeamOwner(request.resource.data.teamId) &&
          request.resource.data.playId == playId &&
          request.resource.data.savedBy == request.auth.uid &&
          request.resource.data.revision is int &&
          revisionId == string(request.resource.data.revision) &&
          copiesPlay(request.resource.data, getAfter(/databases/$(database)/documents/plays/$(playId)).data);

        // History is never edited. The coach may remove copies (pruning old ones, or deleting the play).
        allow update: if false;
        allow delete: if isTeamOwner(resource.data.teamId);
      }
    }

    // Published play snapshots: an immutable copy of one saved revision of a v4 play.
    // Coach only for now: no member, player or public access until the access model has been reviewed.
    match /publishedPlays/{snapshotId} {
      allow read: if isTeamOwner(resource.data.teamId);

      // The id is derived from the play and revision, so a revision can be published once and never replaced.
      allow create: if isTeamOwner(request.resource.data.teamId) &&
        request.resource.data.publishedBy == request.auth.uid &&
        request.resource.data.schemaVersion == 4 &&
        request.resource.data.kind == 'published-play' &&
        request.resource.data.playId is string &&
        request.resource.data.revision is int &&
        snapshotId == request.resource.data.playId + '_r' + string(request.resource.data.revision) &&
        get(/databases/$(database)/documents/plays/$(request.resource.data.playId)).data.schemaVersion == 4 &&
        copiesPlay(request.resource.data, get(/databases/$(database)/documents/plays/$(request.resource.data.playId)).data);

      allow update: if false;
      allow delete: if isTeamOwner(resource.data.teamId);
    }

    // Structural checks for a v4 play. The app validates the full document (football-core validatePlayDocV4);
    // these rules hold the properties that must be true even for a hostile client.
    function isWellFormedPlayV4(data) {
      return data.schemaVersion == 4 &&
        data.revision is int &&
        data.coordinateProfile == 'cc-yards-v1' &&
        data.fieldProfileId is string && data.fieldProfileId.size() <= 40 &&
        data.ruleProfileId is string && data.ruleProfileId.size() <= 40 &&
        data.name is string && data.name.size() <= 120 &&
        data.notes is string && data.notes.size() <= 5000 &&
        data.players is list && data.players.size() >= 1 && data.players.size() <= 22 &&
        data.playerSeq is int && data.playerSeq >= data.players.size() &&
        data.assignments is list && data.assignments.size() <= 44 &&
        data.unresolved is list && data.unresolved.size() <= 44 &&
        data.read is list && data.read.size() <= 12 &&
        data.tags is list && data.tags.size() <= 20 &&
        data.provenance is map &&
        data.ball is map &&
        data.formation is map &&
        // Publishing is a separate snapshot; a play cannot declare itself published.
        !('status' in data);
    }

    // True when this write is committed together with the immutable copy of the revision it creates.
    function hasRevisionCopy(playId, play) {
      return copiesPlay(
        getAfter(/databases/$(database)/documents/plays/$(playId)/revisions/$(string(play.revision))).data, play);
    }

    // A revision copy or published snapshot must be a faithful copy of the play revision it names.
    function copiesPlay(copy, play) {
      return copy.teamId == play.teamId &&
        copy.revision == play.revision &&
        copy.play.schemaVersion == 4 &&
        copy.play.teamId == play.teamId &&
        copy.play.revision == play.revision &&
        copy.play.name == play.name &&
        copy.play.players == play.players &&
        copy.play.assignments == play.assignments &&
        copy.play.formation == play.formation &&
        copy.play.get('defense', null) == play.get('defense', null);
    }

    // User profiles (written by the earlier app build): each user reads and writes only their own; admins read.
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Waitlist sign-ups from the landing page: anyone may add one valid entry; only admins read; nobody edits.
    // Validation carried over unchanged from the rules live since Sep 2025 so existing sign-up forms keep working.
    match /waitlist/{docId} {
      allow create: if isValidWaitlistSubmission(request.resource.data);
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    function isValidEmail(email) {
      return email is string &&
        email.size() > 3 &&
        email.size() <= 200 &&
        email.matches('^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$');
    }

    function hasOnlyAllowedWaitlistKeys(data) {
      return data.keys().hasOnly([
        'email', 'source', 'createdAt', 'timestamp', 'status', 'name', 'role', 'referringCoach',
        'coachingChallenge', 'ipAddress', 'userAgent', 'batchProcessed', 'batchTimestamp', 'metadata',
        'immediateAccess', 'utmSource', 'utmMedium', 'utmCampaign', 'utmId', 'utmTerm', 'utmContent', 'notes'
      ]);
    }

    function isValidWaitlistSubmission(data) {
      let hasCreatedAt = 'createdAt' in data;
      let hasTimestamp = 'timestamp' in data;

      return hasOnlyAllowedWaitlistKeys(data) &&
        isValidEmail(data.email) &&
        (!('source' in data) || (data.source is string && data.source.size() <= 100)) &&
        (hasCreatedAt || hasTimestamp) &&
        (!hasCreatedAt || data.createdAt is timestamp) &&
        (!hasTimestamp || data.timestamp is timestamp) &&
        (!('status' in data) || data.status == null || (data.status is string && data.status.size() <= 50)) &&
        (!('name' in data) || data.name == null || (data.name is string && data.name.size() <= 200)) &&
        (!('role' in data) || data.role == null || (data.role is string && data.role.size() <= 100)) &&
        (!('referringCoach' in data) || data.referringCoach == null || (data.referringCoach is string && data.referringCoach.size() <= 200)) &&
        (!('coachingChallenge' in data) || data.coachingChallenge == null || (data.coachingChallenge is string && data.coachingChallenge.size() <= 1000)) &&
        (!('ipAddress' in data) || data.ipAddress == null || (data.ipAddress is string && data.ipAddress.size() <= 100)) &&
        (!('userAgent' in data) || data.userAgent == null || (data.userAgent is string && data.userAgent.size() <= 1024)) &&
        (!('batchProcessed' in data) || data.batchProcessed is bool) &&
        (!('batchTimestamp' in data) || data.batchTimestamp is timestamp) &&
        (!('metadata' in data) || data.metadata == null || data.metadata is map) &&
        (!('immediateAccess' in data) || data.immediateAccess is bool) &&
        (!('utmSource' in data) || data.utmSource == null || (data.utmSource is string && data.utmSource.size() <= 100)) &&
        (!('utmMedium' in data) || data.utmMedium == null || (data.utmMedium is string && data.utmMedium.size() <= 100)) &&
        (!('utmCampaign' in data) || data.utmCampaign == null || (data.utmCampaign is string && data.utmCampaign.size() <= 150)) &&
        (!('utmId' in data) || data.utmId == null || (data.utmId is string && data.utmId.size() <= 100)) &&
        (!('utmTerm' in data) || data.utmTerm == null || (data.utmTerm is string && data.utmTerm.size() <= 100)) &&
        (!('utmContent' in data) || data.utmContent == null || (data.utmContent is string && data.utmContent.size() <= 150)) &&
        (!('notes' in data) || data.notes == null || (data.notes is string && data.notes.size() <= 1000));
    }

    // Everything else (cspViolations, waitlistMetadata, waitlist_drip_tasks, and any collection not listed
    // above) is closed to the app. Server code using the Admin SDK is not subject to these rules.
  }
}
