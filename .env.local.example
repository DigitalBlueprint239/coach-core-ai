# Coach Core AI — local web configuration (Create React App)
# Copy to .env.local and fill in values from the Firebase console of the
# STAGING project. Never commit .env.local.
#
# These Firebase web values are public identifiers, not secrets. Restrict the
# API key in Google Cloud (HTTP referrers + API allowlist).
#
# NEVER put AI provider keys or any other secret in a REACT_APP_* variable:
# Create React App publishes every REACT_APP_* value in the browser bundle,
# and `npm run build` refuses to run if one looks like a secret. The OpenAI
# key lives only in Google Cloud Secret Manager as COACH_CORE_OPENAI_API_KEY.

REACT_APP_FIREBASE_API_KEY=your_firebase_web_api_key
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project-id
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id
REACT_APP_FIREBASE_MEASUREMENT_ID=your_measurement_id
