rules_version = '2';

// Coach Core AI — Cloud Storage security rules (private beta)
//
// Owner-only. The only writable path is teams/{teamId}/files/{fileName}, and
// only for the private-beta owner of that team (checked against Firestore).
// Legacy paths (practice-plans/*, plays/*/media, teams/*/documents,
// users/*/profile) are denied until a reviewed need exists.
//
// NOTE for deploy: cross-service rules (firestore.get) require granting the
// Storage service agent access to Firestore the first time these rules are
// deployed. That is a live-project change and needs founder approval.

service firebase.storage {
  match /b/{bucket}/o {

    function isBetaUser() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.auth.token.email_verified == true
        && request.auth.token.beta == true;
    }

    function ownsTeam(teamId) {
      return firestore.exists(/databases/(default)/documents/teams/$(teamId))
        && firestore.get(/databases/(default)/documents/teams/$(teamId)).data.ownerId
             == request.auth.uid;
    }

    // 5 MB, images and PDFs only.
    function isAllowedUpload() {
      return request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)|application/pdf');
    }

    match /teams/{teamId}/files/{fileName} {
      allow read, delete: if isBetaUser() && ownsTeam(teamId);
      allow create, update: if isBetaUser() && ownsTeam(teamId) && isAllowedUpload();
    }

    // ---------- film analyzer (FILM-S1: quarantine intake only) ----------
    // A coach may CREATE exactly one object, at the path the server reserved
    // for them, while that reservation is open. The object must match the
    // reservation's declared size and the allowed content type. Nothing under
    // quarantine/, films/ or frames/ is readable, updatable or deletable by
    // any client: processing, playback and cleanup are server-only.
    //
    // PENDING_D3 placeholder: the 100000000-byte literal below mirrors
    // functions/src/film/limits.js (test FS-25 pins them together). It is
    // NOT an approved limit.
    function filmReservation(teamId, filmId) {
      return firestore.get(/databases/(default)/documents/teams/$(teamId)/films/$(filmId)).data;
    }

    function filmReservationOpen(teamId, filmId) {
      return firestore.exists(/databases/(default)/documents/teams/$(teamId)/films/$(filmId))
        && filmReservation(teamId, filmId).status == 'reserved'
        && filmReservation(teamId, filmId).createdBy == request.auth.uid
        && filmReservation(teamId, filmId).reservationExpiresAt > request.time;
    }

    function isReservedFilmUpload(teamId, filmId) {
      return request.resource.size > 0
        && request.resource.size <= 100000000
        && request.resource.size == filmReservation(teamId, filmId).declaredBytes
        && request.resource.contentType == 'video/mp4';
    }

    match /quarantine/{teamId}/{filmId}/source.mp4 {
      allow create: if isBetaUser()
        && ownsTeam(teamId)
        && filmReservationOpen(teamId, filmId)
        && isReservedFilmUpload(teamId, filmId);
      allow read, update, delete: if false;
    }

    match /quarantine/{allPaths=**} {
      allow read, write: if false;
    }
    match /films/{allPaths=**} {
      allow read, write: if false;
    }
    match /frames/{allPaths=**} {
      allow read, write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
