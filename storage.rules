rules_version = '2';

// Coach Core AI — Cloud Storage security rules (private beta)
//
// Owner-only. The only writable path is teams/{teamId}/files/{fileName}, and
// only for the private-beta owner of that team (checked against Firestore).
// Legacy paths (practice-plans/*, plays/*/media, teams/*/documents,
// users/*/profile) are denied until a reviewed need exists.
//
// NOTE for deploy: cross-service rules (firestore.get) require granting the
// Storage service agent access to Firestore the first time these rules are
// deployed. That is a live-project change and needs founder approval.

service firebase.storage {
  match /b/{bucket}/o {

    function isBetaUser() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.auth.token.email_verified == true
        && request.auth.token.beta == true;
    }

    function ownsTeam(teamId) {
      return firestore.exists(/databases/(default)/documents/teams/$(teamId))
        && firestore.get(/databases/(default)/documents/teams/$(teamId)).data.ownerId
             == request.auth.uid;
    }

    // 5 MB, images and PDFs only.
    function isAllowedUpload() {
      return request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)|application/pdf');
    }

    match /teams/{teamId}/files/{fileName} {
      allow read, delete: if isBetaUser() && ownsTeam(teamId);
      allow create, update: if isBetaUser() && ownsTeam(teamId) && isAllowedUpload();
    }

    // ---------- film (coach-film.v1, FILM-S1) ----------
    // Quarantine upload: create-only, by the reservation's creator, while the
    // server-owned film document says `reserved` and unexpired, with the
    // exact declared size. No client read/update/delete under quarantine/,
    // films/ or frames/ (default deny). Literals below must equal
    // functions/src/film/limits.js (static test FS-25). TEST PLACEHOLDERS:
    // maxBytes PENDING_D3, content type PENDING_D3.
    function filmDocPath(teamId, filmId) {
      return /databases/(default)/documents/teams/$(teamId)/films/$(filmId);
    }

    // R7: the film document is read once and evaluated as a value
    // (one exists + one get on the same path) instead of five gets.
    function isLiveFilm(film, teamId, filmId) {
      return film.teamId == teamId
        && film.filmId == filmId
        && film.createdBy == request.auth.uid
        && film.status == 'reserved'
        && request.time < film.reservationExpiresAt
        && request.resource.size == film.declaredBytes;
    }

    function isLiveFilmReservation(teamId, filmId) {
      return firestore.exists(filmDocPath(teamId, filmId))
        && isLiveFilm(firestore.get(filmDocPath(teamId, filmId)).data, teamId, filmId);
    }

    match /quarantine/{teamId}/{filmId}/source.mp4 {
      allow create: if isBetaUser()
        && resource == null
        && ownsTeam(teamId)
        && request.resource.size > 0
        && request.resource.size <= 100000000
        && request.resource.contentType == 'video/mp4'
        && isLiveFilmReservation(teamId, filmId);
      allow read, update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
