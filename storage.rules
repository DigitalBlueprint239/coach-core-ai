rules_version = '2';

// Coach Core Storage baseline: team-private content belongs to its actual owner.
// Do not broaden to "any signed-in account". Team/player/student media is private.
// Storage rules reference Cloud Firestore's DEFAULT database to check document ownership.
// Enabling cross-product rules requires the Firebase Rules Firestore service agent IAM grant.
// No client-visible public link / shared video authorization is granted by these rules.
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function ownsTeam(teamId) {
      return signedIn() &&
        firestore.get(/databases/(default)/documents/teams/$(teamId)).data.ownerId == request.auth.uid;
    }

    function ownsPlay(playId) {
      return signedIn() &&
        ownsTeam(firestore.get(/databases/(default)/documents/plays/$(playId)).data.teamId);
    }

    function ownsPracticePlan(planId) {
      return signedIn() &&
        ownsTeam(firestore.get(/databases/(default)/documents/practicePlans/$(planId)).data.teamId);
    }

    // These are maximum accepted metadata sizes and declared MIME types, not malware/content
    // scanning. SVG (active/script-capable), video, executable files and archives are not enabled.
    function safeImage(maxBytes) {
      return request.resource != null &&
        request.resource.size > 0 &&
        request.resource.size <= maxBytes &&
        request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    function safeDocument(maxBytes) {
      return request.resource != null &&
        request.resource.size > 0 &&
        request.resource.size <= maxBytes &&
        request.resource.contentType.matches('(image/(jpeg|png|webp)|application/pdf|text/plain)');
    }

    // Profile images: exact owner only. No global authenticated read of another user.
    match /users/{userId}/profile/{fileName} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn() && request.auth.uid == userId &&
        safeImage(5 * 1024 * 1024);
      allow delete: if signedIn() && request.auth.uid == userId;
      // No list: knowledge of a folder name is not permission to enumerate its files.
    }

    // Team-owned documents. Membership alone is not edit authorization.
    match /teams/{teamId}/documents/{fileName} {
      allow get: if ownsTeam(teamId);
      allow create, update: if ownsTeam(teamId) && safeDocument(10 * 1024 * 1024);
      allow delete: if ownsTeam(teamId);
    }

    // Check BOTH associated practice plan and its owning team. Two Firestore document
    // accesses at most per request, within the Storage rules limit.
    match /practice-plans/{planId}/attachments/{fileName} {
      allow get: if ownsPracticePlan(planId);
      allow create, update: if ownsPracticePlan(planId) && safeDocument(10 * 1024 * 1024);
      allow delete: if ownsPracticePlan(planId);
    }

    // Play diagrams / static media. Film-video sharing needs its own reviewed model.
    match /plays/{playId}/media/{fileName} {
      allow get: if ownsPlay(playId);
      allow create, update: if ownsPlay(playId) && safeImage(10 * 1024 * 1024);
      allow delete: if ownsPlay(playId);
    }

    // Deny everything else by default, including unknown folders, broad lists,
    // and any legacy paths not covered by explicitly reviewed ownership checks.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
