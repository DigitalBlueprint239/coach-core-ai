    "AttemptExhaustionInput": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "minItems": 1,
      "maxItems": 3,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "end": {
                "type": "string",
                "const": "media-verdict"
              },
              "reason": {
                "type": "string",
                "enum": [
                  "container-invalid",
                  "metadata-invalid",
                  "video-stream-missing",
                  "video-codec-not-allowed",
                  "audio-codec-not-allowed",
                  "stream-count-exceeded",
                  "duration-over-limit",
                  "resolution-over-limit",
                  "media-corrupt",
