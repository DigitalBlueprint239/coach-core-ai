            "required": [
              "end",
              "kill",
              "step"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "end": {
                "type": "string",
                "const": "infrastructure"
              }
            },
            "required": [
              "end"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "end": {
                "type": "string",
                "const": "unknown"
              }
            },
            "required": [
              "end"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "end": {
                "type": "string",
                "const": "crash"
              }
            },
            "required": [
              "end"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "end": {
                "type": "string",
